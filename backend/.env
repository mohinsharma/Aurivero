# MINDMARK Backend Environment Configuration

# Server Settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8005
SECRET_KEY=mindmark_super_secret_jwt_key_dalal_street_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Integration (Google Gemini)
# If GEMINI_API_KEY is unset or empty, the backend automatically runs in deterministic Local AI Mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database (Supabase / PostgreSQL)
# If SUPABASE_URL is unset or empty, backend runs with high-performance local SQLite database
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=sqlite:///./mindmark.db

# Market Data
MARKET_DATA_PROVIDER=verified_historical
ENABLE_LIVE_DATA_REFRESH=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
